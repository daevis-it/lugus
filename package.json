{
  "name": "lugus",
  "displayName": "Lugus",
  "description": "Master of all languages. Turn inline pseudocode comments into production code.",
  "version": "0.1.0",
  "publisher": "daevis-it",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daevis-it/lugus.git"
  },
  "homepage": "https://github.com/daevis-it/lugus#readme",
  "bugs": {
    "url": "https://github.com/daevis-it/lugus/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "pseudocode",
    "code-generation",
    "inline",
    "byok",
    "ollama",
    "anthropic",
    "openai"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lugus.translate",
        "title": "Lugus: Translate / Recompile Pseudocode Block"
      },
      {
        "command": "lugus.detach",
        "title": "Lugus: Detach Block (Keep Clean Code)"
      },
      {
        "command": "lugus.setApiKey",
        "title": "Lugus: Set API Key"
      }
    ],
    "keybindings": [
      {
        "command": "lugus.translate",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Lugus",
      "properties": {
        "lugus.provider": {
          "type": "string",
          "enum": ["anthropic", "openai", "ollama", "custom"],
          "enumDescriptions": [
            "Anthropic Claude API (https://api.anthropic.com/v1)",
            "OpenAI API (https://api.openai.com/v1)",
            "Local Ollama server (http://localhost:11434/v1)",
            "Custom OpenAI-compatible endpoint (OpenRouter, Groq, LM Studio, DeepSeek, etc.)"
          ],
          "default": "anthropic",
          "description": "AI provider used for pseudocode translation."
        },
        "lugus.model": {
          "type": "string",
          "default": "",
          "description": "Optional model override. Leave empty to use the default model for the selected provider."
        },
        "lugus.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional base URL override. Required when provider is set to 'custom'."
        },
        "lugus.blockMode": {
          "type": "string",
          "enum": ["linked", "replace", "comment"],
          "enumDescriptions": [
            "Keep the pseudocode block linked above the generated code with an end marker so you can edit and recompile it anytime.",
            "Replace the pseudocode block directly with the generated code (one-shot).",
            "Convert the pseudocode block into standard static comments above the generated code."
          ],
          "default": "linked",
          "description": "Controls how Lugus writes translated code back into the editor."
        },
        "lugus.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show subtle clickable CodeLens actions exclusively above Lugus pseudocode blocks."
        },
        "lugus.contextLines": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Number of surrounding lines (above and below) sent as local context. Set to 0 to disable."
        },
        "lugus.languageOverride": {
          "type": "string",
          "default": "",
          "description": "Force a specific target language (leave empty to auto-detect from the active file)."
        },
        "lugus.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 3000,
          "description": "Request timeout in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "vscode:prepublish": "npm run package",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}