{
  "name": "lugus",
  "displayName": "Lugus",
  "description": "Keep the rule next to the code it implements. Lugus turns natural-language rules into code, updates that code when the rule changes, and tells you when the two drift apart.",
  "version": "0.3.0",
  "publisher": "daevis-it",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daevis-it/lugus.git"
  },
  "homepage": "https://github.com/daevis-it/lugus#readme",
  "bugs": {
    "url": "https://github.com/daevis-it/lugus/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "pseudocode",
    "code-generation",
    "inline",
    "byok",
    "ollama",
    "anthropic",
    "openai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lugus.translate",
        "title": "Lugus: Translate / Update Block"
      },
      {
        "command": "lugus.linkSelection",
        "title": "Lugus: Link Selection to a Rule (Inline)"
      },
      {
        "command": "lugus.linkSymbol",
        "title": "Lugus: Link Function to a Rule (Sidecar)"
      },
      {
        "command": "lugus.linkFile",
        "title": "Lugus: Link Whole File to a Rule (Sidecar)"
      },
      {
        "command": "lugus.accept",
        "title": "Lugus: Accept Block As Aligned"
      },
      {
        "command": "lugus.restore",
        "title": "Lugus: Restore Last Aligned Code"
      },
      {
        "command": "lugus.showDrifted",
        "title": "Lugus: Show Blocks to Review"
      },
      {
        "command": "lugus.detach",
        "title": "Lugus: Detach Block (Keep Code)"
      },
      {
        "command": "lugus.setApiKey",
        "title": "Lugus: Set API Key"
      },
      {
        "command": "lugus.sidecar.editRule",
        "title": "Lugus: Edit Sidecar Rule"
      },
      {
        "command": "lugus.sidecar.openRules",
        "title": "Lugus: Open Sidecar Rules File"
      },
      {
        "command": "lugus.moveToSidecar",
        "title": "Lugus: Move Block to Sidecar"
      },
      {
        "command": "lugus.moveInline",
        "title": "Lugus: Move Sidecar Rule Inline"
      },
      {
        "command": "lugus.sidecar.update",
        "title": "Lugus: Update Code (Sidecar Rule)"
      },
      {
        "command": "lugus.sidecar.accept",
        "title": "Lugus: Accept (Sidecar Rule)"
      },
      {
        "command": "lugus.sidecar.restore",
        "title": "Lugus: Restore (Sidecar Rule)"
      },
      {
        "command": "lugus.sidecar.detach",
        "title": "Lugus: Delete Sidecar Rule"
      },
      {
        "command": "lugus.sidecar.reattach",
        "title": "Lugus: Re-attach Sidecar Rule"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lugus.linkSelection",
          "when": "editorHasSelection && !editorReadonly",
          "group": "1_modification@90"
        },
        {
          "command": "lugus.linkSymbol",
          "when": "!editorReadonly && resourceScheme == file",
          "group": "1_modification@91"
        },
        {
          "command": "lugus.linkFile",
          "when": "!editorReadonly && resourceScheme == file",
          "group": "1_modification@92"
        }
      ],
      "commandPalette": [
        {
          "command": "lugus.sidecar.update",
          "when": "false"
        },
        {
          "command": "lugus.sidecar.accept",
          "when": "false"
        },
        {
          "command": "lugus.sidecar.restore",
          "when": "false"
        },
        {
          "command": "lugus.sidecar.detach",
          "when": "false"
        },
        {
          "command": "lugus.sidecar.reattach",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "lugus.linkFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@90"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lugus.translate",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Lugus",
      "properties": {
        "lugus.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "ollama",
            "custom"
          ],
          "enumDescriptions": [
            "Anthropic Claude API (https://api.anthropic.com/v1)",
            "OpenAI API (https://api.openai.com/v1)",
            "Local Ollama server (http://localhost:11434/v1)",
            "Custom OpenAI-compatible endpoint (OpenRouter, Groq, LM Studio, DeepSeek, etc.)"
          ],
          "default": "anthropic",
          "description": "AI provider used for pseudocode translation."
        },
        "lugus.model": {
          "type": "string",
          "default": "",
          "description": "Optional model override. Leave empty to use the default model for the selected provider."
        },
        "lugus.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional base URL override. Required when provider is set to 'custom'."
        },
        "lugus.blockMode": {
          "type": "string",
          "enum": [
            "linked",
            "replace",
            "comment"
          ],
          "enumDescriptions": [
            "Keep the rule above the code with a fingerprinted end marker, so Lugus can detect drift and update the code when the rule changes.",
            "Replace the pseudocode block directly with the generated code (one-shot).",
            "Convert the pseudocode block into standard static comments above the generated code."
          ],
          "default": "linked",
          "description": "Controls how Lugus writes translated code back into the editor."
        },
        "lugus.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show block status and actions (Translate, Update Code, Accept, Detach) above Lugus rules."
        },
        "lugus.contextLines": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Number of surrounding lines (above and below) sent as local context. Set to 0 to disable."
        },
        "lugus.languageOverride": {
          "type": "string",
          "default": "",
          "description": "Force a specific target language (leave empty to auto-detect from the active file)."
        },
        "lugus.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 3000,
          "description": "Request timeout in milliseconds. Local models may need more."
        },
        "lugus.driftSeverity": {
          "type": "string",
          "enum": [
            "warning",
            "information",
            "hint",
            "off"
          ],
          "enumDescriptions": [
            "Show drifted blocks as warnings in the editor and the Problems panel.",
            "Show drifted blocks as information.",
            "Show drifted blocks as faint hints in the editor only.",
            "Do not report drift as diagnostics (CodeLens still shows the status)."
          ],
          "default": "warning",
          "description": "How blocks whose rule and code no longer match are reported in the Problems panel."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:cli",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build:cli": "esbuild src/cli.ts --bundle --outfile=dist/cli.js --format=cjs --platform=node --target=node18 --banner:js=\"#!/usr/bin/env node\"",
    "watch": "npm run build:ext -- --watch",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "vscode:prepublish": "npm run package",
    "prepare": "npm run build:cli",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "cd out-test && node --test",
    "test:smoke": "npm run build:ext && esbuild src/core/blocks.ts --bundle --platform=node --format=cjs --outfile=out-test/smoke-core.js && node test/smoke/smoke.js dist/extension.js out-test/smoke-core.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "bin": {
    "lugus": "./dist/cli.js"
  }
}
